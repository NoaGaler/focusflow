# nginx inside the client container (port 3000).
# Serves the React build, and - only if API_UPSTREAM is set (docker compose) -
# forwards /api and /health to the server container.
# In the cloud API_UPSTREAM is empty: the Load Balancer sends /api to the server.
server {
    listen 3000;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    client_max_body_size 2m;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "DENY" always;
    add_header Permissions-Policy "camera=(self), microphone=(), geolocation=()" always;

    gzip on;
    gzip_types text/css application/javascript application/json application/wasm image/svg+xml;

${API_PROXY_BLOCK}

    # Model and library files never change between builds -> cache for a day.
    location ~ ^/(models|mediapipe|assets)/ {
        # .mjs is missing from nginx's default MIME list; browsers refuse modules served as binary.
        types {
            application/javascript js mjs;
            application/wasm wasm;
            text/css css;
            image/svg+xml svg;
        }
        default_type application/octet-stream;
        add_header Cache-Control "public, max-age=86400";
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }

    # React Router: every other path returns index.html.
    location / {
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header X-Frame-Options "DENY" always;
        add_header Permissions-Policy "camera=(self), microphone=(), geolocation=()" always;
        try_files $uri /index.html;
    }
}

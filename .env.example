# .env.example - copy to ".env" (never commit .env).
# Everything runs locally in docker compose (client, server, MongoDB container).

# MongoDB container. Use the SERVICE NAME from docker-compose.yml ("mongo"), NOT localhost.
MONGODB_URI=mongodb://mongo:27017
DB_NAME=focusflow

# Optional, recommended: secret used to sign login tokens (any long random string, 32+ chars).
# If empty, the server makes a random one at every start (everyone is logged out on restart).
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Not used by this project (no Gemini features). Submit it EMPTY.
GEMINI_API_KEY=
